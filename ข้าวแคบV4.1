local function createToggle(parent, text, defaultValue, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 40)
    frame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    frame.BorderSizePixel = 0
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -70, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 13
    label.Font = Enum.Font.SourceSans
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.new(0, 50, 0, 24)
    switch.Position = UDim2.new(1, -60, 0.5, -12)
    switch.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    switch.Text = ""
    switch.AutoButtonColor = false
    switch.Parent = frame
    Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 20, 0, 20)
    knob.Position = UDim2.new(0, 2, 0.5, -10)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.Parent = switch
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = defaultValue or false
    local function update()
        switch.BackgroundColor3 = state and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(80, 80, 80)
        knob.Position = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
    end
    update()
    switch.MouseButton1Click:Connect(function()
        state = not state
        update()
        if callback then callback(state) end
    end)
end

-- ===== เก็บของ Auto =====
local SCAN_TICK = 0.03
local MAX_DISTANCE = 100
local MAX_PER_PASS = 50
local PASSES_PER_TICK = 3
local PROMPT_COOLDOWN = 0.15
local lastScan = 0
local promptCooldown, cachedPrompts, farm = {}, {}, nil
local collectAllEnabled = false

local function getMyFarm()
    if farm and farm.Parent then return farm end
    local f = Workspace:FindFirstChild("Farm")
    if not f then return end
    for _, fm in ipairs(f:GetChildren()) do
        if fm:GetAttribute("OwnerId") == LocalPlayer.UserId then
            farm = fm
            return fm
        end
    end
end

local function firePrompt(prompt)
    if not prompt.Parent or not prompt.Enabled then return false end
    local now = os.clock()
    if promptCooldown[prompt] and (now - promptCooldown[prompt]) < PROMPT_COOLDOWN then return false end
    promptCooldown[prompt] = now
    pcall(function()
        local orig = prompt.HoldDuration
        prompt.HoldDuration = 0
        prompt:InputHoldBegin()
        prompt:InputHoldEnd()
        prompt.HoldDuration = orig
    end)
    return true
end

local function addPrompt(prompt)
    local part = prompt.Parent
    if part and part:IsA("BasePart") then
        table.insert(cachedPrompts, { prompt = prompt, part = part })
    end
end

local function rebuildCache()
    cachedPrompts = {}
    local f = getMyFarm()
    if not f then return end
    for _, obj in ipairs(f:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then addPrompt(obj) end
    end
end

local function onePass(pos)
    local count = 0
    for i = 1, #cachedPrompts do
        local e = cachedPrompts[i]
        local prompt, part = e.prompt, e.part
        if prompt.Parent and prompt.Enabled and part.Parent then
            local dx, dy, dz = part.Position.X - pos.X, part.Position.Y - pos.Y, part.Position.Z - pos.Z
            if (dx*dx + dy*dy + dz*dz) <= MAX_DISTANCE * MAX_DISTANCE and firePrompt(prompt) then
                count += 1
                if count >= MAX_PER_PASS then break end
            end
        end
    end
    return count
end

local function burstScan()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local pos = hrp.Position
    for _ = 1, PASSES_PER_TICK do
        if onePass(pos) == 0 then break end
    end
    local now = os.clock()
    for p, t in pairs(promptCooldown) do
        if not p.Parent or (now - t) > 5 then promptCooldown[p] = nil end
    end
end

task.spawn(function()
    while not getMyFarm() do task.wait(1) end
    rebuildCache()
    local f = farm
    f.DescendantAdded:Connect(function(obj)
        if obj:IsA("ProximityPrompt") then addPrompt(obj) end
    end)
    f.DescendantRemoving:Connect(function(obj)
        if obj:IsA("ProximityPrompt") then
            for i = #cachedPrompts, 1, -1 do
                if cachedPrompts[i].prompt == obj then table.remove(cachedPrompts, i) end
            end
        end
    end)
end)

RunService.Heartbeat:Connect(function()
    if not collectAllEnabled then return end
    local now = os.clock()
    if now - lastScan < SCAN_TICK then return end
    lastScan = now
    burstScan()
end)

-- ===== Remotes =====
local RequestClaimProduction
local RequestStartProduction
local FactoryCfg
task.spawn(function()
    local Remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
    if not Remotes then return end
    RequestClaimProduction = Remotes:WaitForChild("RequestClaimProduction", 15)
    RequestStartProduction = Remotes:WaitForChild("RequestStartProduction", 15)
    local Modules = ReplicatedStorage:WaitForChild("Modules", 20)
    local FactoryConfig = Modules and Modules:FindFirstChild("FactoryConfig")
    if FactoryConfig then
        local ok, mod = pcall(require, FactoryConfig)
        if ok then FactoryCfg = mod.Config end
    end
end)

local function safeJsonDecode(str, default)
    if type(str) ~= "string" or str == "" then return default or {} end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, str)
    if ok and type(data) == "table" then return data end
    return default or {}
end

-- ===== เก็บผล Auto =====
local CLAIM_INTERVAL = 0.8
local lastClaim = 0
local AP_ENABLED = false

local function hasReadyToClaim(factoryName)
    local data = safeJsonDecode(LocalPlayer:GetAttribute("FactoryQueue_JSON"), {})[factoryName]
    if not data then return false end
    local now = Workspace:GetServerTimeNow()
    for _, item in ipairs(data.Q or data) do
        if type(item) == "table" and now >= (item.EndTime or 0) then return true end
    end
    for _, key in ipairs({"R", "B"}) do
        local v = data[key]
        if type(v) == "table" then
            for _, n in pairs(v) do
                if tonumber(n) and tonumber(n) > 0 then return true end
            end
        elseif tonumber(v) and tonumber(v) > 0 then
            return true
        end
    end
    return false
end

local function autoClaim()
    if not AP_ENABLED then return end
    if not RequestClaimProduction or not FactoryCfg then return end
    if os.clock() - lastClaim < CLAIM_INTERVAL then return end
    lastClaim = os.clock()
    for factoryName in pairs(safeJsonDecode(LocalPlayer:GetAttribute("UnlockedFactories_JSON"), {})) do
        if FactoryCfg[factoryName] and hasReadyToClaim(factoryName) then
            pcall(function() RequestClaimProduction:InvokeServer(factoryName) end)
            task.wait(0.3)
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(autoClaim)
    end
end)

-- ===== ตีหมา Auto =====
local BossDamage = ReplicatedStorage:WaitForChild("BossDamageEvent", 20)
local WOLF_HIT_ENABLED = false
local WOLF_HIT_CD = 0.05
local WOLF_HIT_CRIT = true
local wolfHitTarget, wolfHitLast = nil, 0

local function findWolfForHit()
    for _, m in ipairs(Workspace:GetChildren()) do
        if m:IsA("Model") and (m.Name == "Werewolf - Black" or m.Name:find("Werewolf")) then
            local h = m:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then return m, h end
        end
    end
end

task.spawn(function()
    while task.wait(0.03) do
        if not WOLF_HIT_ENABLED then wolfHitTarget = nil continue end
        if not wolfHitTarget or not wolfHitTarget.Parent then
            local wolf = findWolfForHit()
            if wolf then wolfHitTarget = wolf end
        end
        if not wolfHitTarget or not wolfHitTarget.Parent then wolfHitTarget = nil continue end
        local hum = wolfHitTarget:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then wolfHitTarget = nil continue end
        local now = os.clock()
        if now - wolfHitLast >= WOLF_HIT_CD then
            wolfHitLast = now
            pcall(function() BossDamage:FireServer(wolfHitTarget, WOLF_HIT_CRIT) end)
        end
    end
end)

-- ===== ผลิต Auto (เต็มทุก Slot + Tier แพง → ถูก) =====
local TIER_ORDER = { "Cosmic", "Sakura", "Gold", "Default" }
local preferredTier = {}
local runningFactories = {}

-- ✅ จำนวน slot สูงสุดต่อโรงงาน (ปรับตามเกมจริง)
local MAX_SLOTS = {
    FlourFactory   = 5,
    BreadFactory   = 5,
    YarnFactory    = 5,
    SweaterFactory = 5,
    SausageFactory = 5,
    HotdogFactory  = 5,
    ButterFactory  = 5,
    CheeseFactory  = 5,
}

-- ✅ เริ่มนับ slot ที่ 1 (ถ้าเกมใช้ 0-based → เปลี่ยนเป็น 0)
local SLOT_START = 1

-- ✅ หน่วงระหว่างยิงแต่ละ slot (กัน server reject)
local SLOT_DELAY = 0.08

local function tryStartWithBestTier(factory, slot)
    if not RequestStartProduction then return false end

    local order = {}
    local pref = preferredTier[factory]
    if pref then table.insert(order, pref) end
    for _, t in ipairs(TIER_ORDER) do
        if t ~= pref then table.insert(order, t) end
    end

    for _, tierName in ipairs(order) do
        local ok, res = pcall(function()
            return RequestStartProduction:InvokeServer("Start", factory, slot, tierName)
        end)
        if ok and res then
            preferredTier[factory] = tierName
            return true
        end
    end
    return false
end

-- ✅ เติมทุก slot ที่ว่างในโรงงานเดียว
local function fillAllSlots(factory)
    local maxSlots = MAX_SLOTS[factory] or 1
    local started = 0
    for slot = SLOT_START, SLOT_START + maxSlots - 1 do
        if not runningFactories[factory] then break end
        if tryStartWithBestTier(factory, slot) then
            started += 1
        end
        task.wait(SLOT_DELAY)
    end
    return started
end

local function startFactoryLoop(key, factory, interval)
    if runningFactories[key] then return end
    runningFactories[key] = true
    runningFactories[factory] = true  -- ใช้ flag คู่กับชื่อ factory ด้วย
    task.spawn(function()
        while runningFactories[key] do
            fillAllSlots(factory)
            local elapsed = 0
            while runningFactories[key] and elapsed < interval do
                task.wait(0.1)
                elapsed += 0.1
            end
        end
        runningFactories[factory] = nil
    end)
end

local function stopFactoryLoop(key, factory)
    runningFactories[key] = false
    if factory then runningFactories[factory] = nil end
end

